# ─────────────────────────────────────────────────────────────
# ExpertzTrip environment configuration (Phase 1)
# Copy to `.env` for local dev. NEVER commit real secrets.
# Separate values are expected per environment: development / staging / production.
# ─────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database ---
# Dev uses SQLite. In staging/production point this at Postgres and
# switch the datasource provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# --- Auth / sessions ---
# 32+ char random string. Used to sign session + OTP tokens.
AUTH_SECRET="change-me-in-production-min-32-characters"
SESSION_COOKIE_NAME="etx_session"

# --- OTP / SMS provider (Phase 13) ---
# Dev: SMS_PROVIDER=console prints OTPs to the server log (no cost).
# Prod (India): set SMS_PROVIDER to msg91 or fast2sms + SMS_API_KEY.
#   msg91 needs DLT-approved template ids (branded text lives in the template):
#     MSG91_OTP_TEMPLATE_ID (var: OTP) and MSG91_WELCOME_TEMPLATE_ID (var: name).
#   fast2sms uses the OTP route (code only) with just SMS_API_KEY.
# Sender header is max 6 chars (DLT).
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=EXPRTZ
MSG91_OTP_TEMPLATE_ID=
MSG91_WELCOME_TEMPLATE_ID=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# --- Razorpay (Phase 16) ---
# Server-side keys. Frontend only ever receives the public key id.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Transactional email (Phase 20) ---
# Dev: console. Prod: EMAIL_PROVIDER=resend + EMAIL_API_KEY (re_…).
# EMAIL_FROM domain must be verified in Resend; use onboarding@resend.dev to test.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="ExpertzTrip <onboarding@resend.dev>"

# --- AI assistant (Phase 21) ---
# Set AI_API_KEY to your OpenAI (or compatible) key to turn on the LLM assistant.
# It answers ONLY from real DB packages via a function-call tool — never invents.
# Without a key, the assistant falls back to grounded keyword search.
AI_PROVIDER=openai
AI_API_KEY=              # e.g. sk-...   (server-side only, never exposed to the browser)
AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1   # override for Azure/compatible gateways
