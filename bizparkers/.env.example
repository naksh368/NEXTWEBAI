# Admin login for /admin
ADMIN_EMAIL=bizparkers@gmail.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# Long random string that signs admin sessions (keeps you signed in across restarts)
SESSION_SECRET=paste-a-long-random-string-here

# Database. Leave empty to store data in a file in DATA_DIR (needs a persistent disk).
# Recommended in production: a Postgres URL (Neon, Supabase, Railway, Render).
DATABASE_URL=
DATA_DIR=./data

# Optional: email me every new enquiry (https://resend.com, free tier)
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=Bizparkers <onboarding@resend.dev>

# Your public address, used for Google (canonical links, sitemap, share previews)
SITE_URL=
# e.g. SITE_URL=https://www.yourdomain.com (leave empty to use the address people visit)

# Charts use this time zone for days
TIMEZONE=Asia/Kolkata

PORT=3000
