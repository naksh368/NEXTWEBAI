# ─────────────────────────────────────────────────────────────
# ExpertzTrip environment configuration (Phase 1)
# Copy to `.env` for local dev. NEVER commit real secrets.
# Separate values are expected per environment: development / staging / production.
# ─────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database ---
# Dev uses SQLite. In staging/production point this at Postgres and
# switch the datasource provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# --- Clerk Authentication ---
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/account
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/account

# --- Auth / sessions (legacy — kept for admin OTP) ---
AUTH_SECRET="change-me-in-production-min-32-characters"
SESSION_COOKIE_NAME="etx_session"

# --- OTP / SMS provider: MSG91 (Phase 13 + 20) ---
# Dev: SMS_PROVIDER=console prints OTP/SMS to the server log (no cost, no keys).
# Prod (India): SMS_PROVIDER=msg91 + MSG91_AUTH_KEY. India requires DLT-approved
# templates — the branded text lives in the MSG91 template, we only pass variables:
#   MSG91_OTP_TEMPLATE_ID     — login/registration OTP (variable: OTP)
#   MSG91_WELCOME_TEMPLATE_ID — welcome SMS after verification (variable: name)
#   MSG91_TXN_TEMPLATE_ID     — booking/document/itinerary alerts (variable carries the message)
# Without a template id the matching SMS is honestly skipped (never faked).
# Sender header (DLT) is max 6 chars. Both customer AND admin login use MSG91 OTP.
#
# ── To CHANGE any of this AFTER DEPLOYMENT ──
# These are environment variables — edit them in your host's dashboard
# (Vercel: Project → Settings → Environment Variables; or the server's .env),
# then redeploy / restart. No code change is needed to rotate the MSG91 key,
# swap sender id, add template ids, or switch provider back to console.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
SMS_API_KEY=            # legacy fallback for MSG91_AUTH_KEY / fast2sms
SMS_SENDER_ID=EXPRTZ
MSG91_OTP_TEMPLATE_ID=
MSG91_WELCOME_TEMPLATE_ID=
MSG91_TXN_TEMPLATE_ID=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# --- Razorpay (Phase 16 + B2B wallet) ---
# Server-side keys. Frontend only ever receives the public key id.
# The SAME keys power both B2C booking payments and the B2B agent wallet top-up.
# Configure TWO webhook URLs in the Razorpay dashboard (same webhook secret):
#   /api/webhooks/razorpay        — B2C booking payments
#   /api/webhooks/agent-razorpay  — B2B agent wallet top-ups (idempotent credit)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Twilio Verify (mobile OTP for agent registration) ---
# When these are set, registration additionally verifies the agent's mobile via
# a Twilio Verify SMS code (in the same "Verify" step as the email code). When
# unset, mobile is collected but not SMS-verified (email OTP remains the
# verifier) — nothing is faked. Credentials are server-side only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- B2B agent platform ---
# Inbox that receives the "New Agency Registration" alert on every submission
# (falls back to ADMIN_EMAIL, then a built-in default). Server-side only.
ADMIN_NOTIFY_EMAIL=
# Flight supplier key. When unset, the portal honestly shows "supplier being
# onboarded" and never fabricates fares or tickets. Implement an adapter in
# src/lib/services/flight-service.ts and set this to switch live inventory on.
FLIGHT_SUPPLIER=

# --- Transactional email (Phase 20) ---
# Dev: EMAIL_PROVIDER=console (prints to server log).
# Prod: Set EMAIL_PROVIDER to zavu, sendgrid, mailgun, or your chosen service.
# Provide EMAIL_API_KEY for authentication with your chosen provider.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="ExpertzTrip <noreply@expertztrip.com>"

# --- AI assistant (Phase 21) ---
# Set AI_API_KEY to your OpenAI (or compatible) key to turn on the LLM assistant.
# It answers ONLY from real DB packages via a function-call tool — never invents.
# Without a key, the assistant falls back to grounded keyword search.
AI_PROVIDER=openai
AI_API_KEY=              # e.g. sk-...   (server-side only, never exposed to the browser)
AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1   # override for Azure/compatible gateways

# --- Scheduled jobs (cron) ---
# Protects the cron endpoints /api/cron/publish-due (auto-publish scheduled
# packages) and /api/cron/enquiry-followup (nudge un-answered leads after 24h).
# On Vercel the built-in Cron (see vercel.json) is trusted automatically; for any
# other pinger, call the URL with header  Authorization: Bearer <CRON_SECRET>
# or  ?key=<CRON_SECRET> . Generate one with:  openssl rand -base64 24
# If left blank the endpoints still run but are unauthenticated — set this in prod.
CRON_SECRET=
