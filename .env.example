# ─────────────────────────────────────────────────────────────
# JST Andaman Travels — environment configuration
#
# Copy to `.env` for local development. NEVER commit real secrets:
# `.env` is gitignored, `.env.example` is not.
#
# ⚠️  QUOTING: if a value contains "#", wrap it in double quotes, or the
#     parser treats the rest of the line as a comment.
#       ADMIN_PASSWORD="My#Strong#Passphrase"      ✅
#       ADMIN_PASSWORD=My#Strong#Passphrase        ❌ becomes "My"
# ─────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
# The canonical public URL. Used for canonical tags, sitemaps, OG images and
# every absolute link in an email. Without it, links fall back to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
# Any Postgres works. The deploy build creates the tables and fills an empty
# database by itself — see DEPLOYMENT.md §3.
#  · Vercel + Neon: added for you by Vercel's Storage tab.
#  · Supabase:      the "Session pooler" string (port 5432), not "Direct".
#  · Railway:       DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --- Sessions ---
# Signs the httpOnly session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production-min-32-characters"
SESSION_COOKIE_NAME="etx_session"

# --- Initial administrator (REQUIRED to sign in to /admin) ---
# There is NO default password and no public admin sign-up. Until both of
# these are set, the bootstrap admin login is disabled and every attempt is
# denied. ADMIN_EMAIL must be a real inbox: the one-time login code is sent
# there whenever an email provider is configured.
# ADMIN_PASSWORD must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: lets the same administrator sign in with a mobile number too.
ADMIN_MOBILE=

# --- Transactional email ---
# Dev: EMAIL_PROVIDER=console prints the message (and any OTP) to the server
# log — no account, no cost. Prod: set a real provider and API key, otherwise
# customers never receive their enquiry confirmation or login code.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="JST Andaman Travels <noreply@yourdomain.com>"
# Where new-enquiry alerts are sent. Defaults to ADMIN_EMAIL when blank.
BUSINESS_EMAIL=

# --- SMS / OTP (optional) ---
# Dev: SMS_PROVIDER=console prints the code to the server log.
# Prod (India): msg91 + a DLT-approved template id per message type. Without a
# template id the matching SMS is honestly skipped rather than faked.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
SMS_SENDER_ID=JSTAND
MSG91_OTP_TEMPLATE_ID=
MSG91_WELCOME_TEMPLATE_ID=
MSG91_TXN_TEMPLATE_ID=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# --- AI trip planner (optional) ---
# Any OpenAI-compatible endpoint. The assistant answers ONLY from real
# published packages returned by its search tool — it has no inventory of its
# own and cannot invent a price, a hotel or an availability. Leave AI_API_KEY
# blank to turn it off; the planner then falls back to grounded keyword search.
#
# AI_MODEL takes a comma-separated list. On OpenRouter the first is tried
# first and the rest are automatic fallbacks (free models are rate limited, so
# keep two or three). The default chain below is free and supports tool calls.
# Paid alternative:  AI_MODEL=openai/gpt-4o-mini
# OpenAI direct:     AI_BASE_URL=https://api.openai.com/v1  AI_MODEL=gpt-4o-mini
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free
AI_API_KEY=

# --- Payments (optional — enquiry-led booking works without these) ---
# The frontend only ever receives the public key id.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Scheduled jobs ---
# Protects /api/cron/publish-due (auto-publish scheduled packages) and
# /api/cron/enquiry-followup (nudge un-answered leads). On Vercel the built-in
# Cron is trusted automatically; any other pinger must send
#   Authorization: Bearer <CRON_SECRET>   or   ?key=<CRON_SECRET>
# Generate with: openssl rand -base64 24
CRON_SECRET=
